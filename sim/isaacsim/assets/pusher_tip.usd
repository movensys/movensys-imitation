#usda 1.0
(
    defaultPrim = "pusher_tip"
    doc = "PushT pusher tip: a cylinder along +z from the mount face (origin) to the tip bottom at z = 0.08 m. Collision only; it belongs to the rigid link it is parented under. Generated by make_usd_assets.py."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pusher_tip" (
    customData = {
        dictionary pusht = {
            double length_m = 0.08
            double link6_mount_z_m = 0.14
            double radius_m = 0.01
        }
    }
    kind = "component"
)
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "tip_material"
        {
            token outputs:surface.connect = </pusher_tip/Looks/tip_material/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "tip_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    def Cylinder "geom" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        float3[] extent = [(-0.01, -0.01, -0.04), (0.01, 0.01, 0.04)]
        double height = 0.08
        rel material:binding = </pusher_tip/Looks/tip_material>
        rel material:binding:physics = </pusher_tip/Looks/tip_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.01
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

