#usda 1.0
(
    defaultPrim = "t_block"
    doc = "PushT T block (plan Section 5): gym-pusht proportions, origin at the bar-stem junction on the bottom face, yaw 0 = bar along +x on the +y side. Generated by make_usd_assets.py."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "t_block" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        dictionary pusht = {
            double2 bar_xy_m = (0.16, 0.04)
            double2 centroid_local_m = (0, -0.01428571428571428)
            double height_m = 0.03
            int3 rgb = (120, 120, 120)
            double2 stem_xy_m = (0.04, 0.12)
            double unit_m = 0.04
        }
    }
    kind = "component"
)
{
    vector3f physics:angularVelocity = (0, 0, 0)
    float physics:mass = 0.25
    vector3f physics:velocity = (0, 0, 0)
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "block_material"
        {
            token outputs:surface.connect = </t_block/Looks/block_material/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47058824, 0.47058824, 0.47058824)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "block_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Cube "bar" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </t_block/Looks/block_material>
        rel material:binding:physics = </t_block/Looks/block_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.16, 0.04, 0.03)
        double3 xformOp:translate = (0, 0.02, 0.015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "stem" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </t_block/Looks/block_material>
        rel material:binding:physics = </t_block/Looks/block_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.04, 0.12, 0.03)
        double3 xformOp:translate = (0, -0.06, 0.015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

